# --- Local development (static site -> Neon Function) -------------------------
# Neon Function base URL (public). Printed by `neon functions get api` / the deploy workflow.
NEXT_PUBLIC_API_URL=https://br-xxxx-api.compute.ap-southeast-1.aws.neon.tech
# Leave empty locally; the deploy workflow sets /beer-game for GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# --- Database tooling only (npm run db:setup), never sent to the browser -------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
